<resources>
    <!--
      The IME window's theme. Material is API 21, so the base picks DeviceDefault and a -v21
      variant takes Material where it exists; android:fontFamily is API 16 and lives in -v16.
    -->
    <style name="ReteImeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      The screens follow the system's light/dark mode. Theme.DeviceDefault.DayNight would do this
      in one line but only from API 29; picking the light or dark parent through the -night
      resource qualifier is the same result and works everywhere.
    -->
    <style name="ReteScreenTheme" parent="@android:style/Theme.DeviceDefault.Light" />

    <!--
      The two fixed halves, for a user who has asked for light or dark whatever the device is set
      to. They have no -night variant on purpose: that is what "fixed" means here.
    -->
    <style name="ReteScreenThemeLight" parent="@android:style/Theme.DeviceDefault.Light" />
    <style name="ReteScreenThemeDark" parent="@android:style/Theme.DeviceDefault" />
</resources>
